---
export const prerender = false;

import Logo from "../assets/logo.svg";
import ContentContainer from "../components/ContentContainer.astro";
import MusicCard from "../components/MusicCard.astro";
import Layout from "../layouts/Layout.astro";
import { convertMusicLink } from "../services/conversion";
import { getStatusCodeFromError, ValidationError } from "../utils/errors";
import { formatArtistList, toSentenceCase } from "../utils/format";
import type { MusicEntity } from "../music-types";

function generatePageTitle(
  fromEntity: MusicEntity | null,
  toService: string | null
): string {
  if (!fromEntity) return "Error";

  const entityName = fromEntity.name;
  const artists =
    fromEntity.type !== "artist" ? formatArtistList(fromEntity.artists) : "";
  const serviceName = toSentenceCase(toService || "");

  if (fromEntity.type === "artist") {
    return `${entityName} on ${serviceName}`;
  } else {
    return `${entityName} by ${artists} on ${serviceName}`;
  }
}

function generateMetaDescription(
  fromEntity: MusicEntity | null,
  toService: string | null
): string | undefined {
  if (!fromEntity) return undefined;

  const artists =
    fromEntity.type !== "artist" ? formatArtistList(fromEntity.artists) : "";
  const serviceName = toSentenceCase(toService || "");

  return `"${fromEntity.name}" by ${artists} is on ${serviceName}. Convert tracks, albums, and artists between Spotify and Tidal instantly with Music Link Converter.`;
}

function generateCanonicalPath(
  fromEntity: MusicEntity | null
): string | undefined {
  if (!fromEntity) return undefined;
  return `/convert?url=${encodeURIComponent(fromEntity.url)}`;
}

function generateOgImageUrl(
  fromEntity: MusicEntity | null
): string | undefined {
  if (!fromEntity?.images?.[0]?.url) return undefined;
  return fromEntity.images[0].url;
}

const country = Astro.request.cf?.country as string | undefined;
const urlParameter = Astro.url.searchParams.get("url");
const shouldRedirect = Astro.url.searchParams.has("redirect");

const result = await convertMusicLink(urlParameter, country);

if (result.error) {
  Astro.response.status = getStatusCodeFromError(result.error);
}

if (!result.error) {
  Astro.response.headers.set("Cache-Control", "max-age=10800");
}

if (shouldRedirect && result.toEntity && !result.error) {
  return Astro.redirect(result.toEntity.url, 302);
}

const pageTitle = generatePageTitle(result.fromEntity, result.toService);
const metaDescription = generateMetaDescription(
  result.fromEntity,
  result.toService
);
const canonicalPath = generateCanonicalPath(result.fromEntity);
const ogImageUrl = generateOgImageUrl(result.fromEntity);
---

<Layout
  title={pageTitle}
  metaDescription={metaDescription}
  canonicalPath={canonicalPath}
  ogImageUrl={ogImageUrl}
>
  <ContentContainer>
    <div class="header">
      <a href="/" title="Home" class="logo">
        <Logo width="48" height="48" />
      </a>
      <h1>
        {
          result.error
            ? "Error"
            : result.toEntity
              ? "Success!"
              : "No match found"
        }
      </h1>
      <p class="subtitle">
        {
          result.error ? (
            <>
              {result.error instanceof ValidationError
                ? "We couldn't process your link. Note that we only support Spotify and Tidal links, and that playlist links are not supported. Please check your link and try again."
                : "An error occurred while processing your request."}
            </>
          ) : result.fromEntity && result.toService ? (
            <>
              {result.toEntity ? (
                <>We found a match for </>
              ) : (
                <>Unfortunately, we couldn't find a match for </>
              )}
              <i>{result.fromEntity.name}</i>
              {result.fromEntity.type !== "artist" && (
                <> by {formatArtistList(result.fromEntity.artists)}</>
              )}{" "}
              on {toSentenceCase(result.toService)}.
            </>
          ) : null
        }
      </p>
    </div>

    <section class="conversion-content">
      <h2 class="sr-only">Conversion Results</h2>
      {
        result.toEntity && (
          <MusicCard entity={result.toEntity} service={result.toService!} />
        )
      }

      {
        result.fromEntity &&
          !result.toEntity &&
          !result.error &&
          result.toService && (
            <p class="no-results">
              No match was found on {toSentenceCase(result.toService)}
            </p>
          )
      }

      {result.fromEntity && <div class="arrow">↑</div>}

      {
        result.fromEntity && result.fromUrl && (
          <MusicCard
            entity={result.fromEntity}
            service={result.fromUrl.service}
          />
        )
      }

      {
        !result.fromEntity && result.fromUrl && (
          <p class="no-results">
            The {result.fromUrl.type} you specified wasn't found on{" "}
            {toSentenceCase(result.fromUrl.service)}.
          </p>
        )
      }

      <div class="back-link">
        <a href="/">← Convert another link</a>
      </div>
    </section>
  </ContentContainer>
</Layout>

<style>
  .header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .logo {
    display: block;
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
  }

  .subtitle {
    font-size: 1.125rem;
    margin: 0;
  }

  .back-link {
    margin-block: var(--space-lg);
    text-align: center;
  }

  .conversion-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .arrow {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2rem;
  }

  .no-results {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin: var(--space-xl) 0;
    padding: var(--space-lg);
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    max-width: 400px;
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
