---
export const prerender = false;

import Logo from "../assets/logo.svg";
import ContentContainer from "../components/ContentContainer.astro";
import MusicCard from "../components/MusicCard.astro";
import Layout from "../layouts/Layout.astro";
import type { MusicEntity, MusicEntityType } from "../music-types";
import {
  assertSpotifyEntityId,
  getSpotifyEntity,
  searchSpotifyEntity,
  spotifyEntityTypeToMusicEntityType,
} from "../services/spotify";
import {
  assertTidalEntityId,
  getTidalEntity,
  searchTidalEntity,
  tidalShareUrlTypeToEntityType,
} from "../services/tidal";
import { getStatusCodeFromError, ValidationError } from "../utils/errors";
import { toSentenceCase } from "../utils/format";

interface ParsedUrl {
  service: "spotify" | "tidal";
  type: MusicEntityType;
  id: string;
}

async function getUrlData(): Promise<ParsedUrl> {
  try {
    const urlParameter = Astro.url.searchParams.get("url");

    if (!urlParameter) {
      throw new ValidationError("No URL provided");
    }

    const { protocol, hostname, pathname } = new URL(urlParameter);

    if (protocol === "spotify:") {
      const [type, id] = pathname.split(":");
      assertSpotifyEntityId(id);
      return {
        service: "spotify",
        type: spotifyEntityTypeToMusicEntityType(type),
        id,
      };
    } else if (protocol === "tidal:") {
      const type = tidalShareUrlTypeToEntityType(hostname);
      const id = pathname.slice(1);
      assertTidalEntityId(id);
      return { service: "tidal", type, id };
    } else if (protocol === "https:" || protocol === "http:") {
      if (hostname === "open.spotify.com") {
        const pathParts = pathname.split("/");
        const type = pathParts[1];
        const id = pathParts[2];
        assertSpotifyEntityId(id);
        return {
          service: "spotify",
          type: spotifyEntityTypeToMusicEntityType(type),
          id,
        };
      } else if (hostname === "tidal.com") {
        const pathParts = pathname.split("/");
        const type = tidalShareUrlTypeToEntityType(pathParts[2]);
        const id = pathParts[3];
        assertTidalEntityId(id);
        return { service: "tidal", type, id };
      }
    }

    throw new ValidationError("Unsupported URL format");
  } catch (err) {
    if (err instanceof ValidationError) {
      throw err;
    }

    throw new ValidationError("Invalid URL format");
  }
}

const country = Astro.request.cf?.country as string | undefined;

let fromUrl: ParsedUrl | null = null;
let toService: "spotify" | "tidal" | null = null;
let fromEntity: MusicEntity | null = null;
let toEntity: MusicEntity | null = null;
let error: Error | null = null;
let canonicalPath: string | undefined;

try {
  fromUrl = await getUrlData();
  toService = fromUrl.service === "spotify" ? "tidal" : "spotify";

  fromEntity =
    fromUrl.service === "tidal"
      ? await getTidalEntity(fromUrl.type, fromUrl.id, country)
      : await getSpotifyEntity(fromUrl.type, fromUrl.id, country);

  if (fromEntity) {
    const query =
      fromEntity.type === "album" || fromEntity.type === "song"
        ? toService === "spotify"
          ? `${fromEntity.artists.map((artist) => `artist:"${artist.name}"`).join(" ")} ${fromEntity.name}`
          : `${fromEntity.artists.map((artist) => artist.name).join(" ")} ${fromEntity.name}`
        : fromEntity.name;

    toEntity =
      fromUrl.service === "tidal"
        ? await searchSpotifyEntity(fromUrl.type, query, country)
        : await searchTidalEntity(fromUrl.type, query, country);
  }
} catch (err) {
  error = err as Error;
  console.error("Error in convert page:", error);

  Astro.response.status = getStatusCodeFromError(error);
}

let pageTitle = "Error";
let metaDescription: string | undefined;
if (fromEntity) {
  const entityName = fromEntity.name;
  const artists =
    fromEntity.type !== "artist"
      ? fromEntity.artists.map((artist) => artist.name).join(", ")
      : "";
  const serviceName = toSentenceCase(toService || "");

  if (fromEntity.type === "artist") {
    pageTitle = `${entityName} on ${serviceName}`;
  } else {
    pageTitle = `${entityName} by ${artists} on ${serviceName}`;
  }
  metaDescription = `"${fromEntity.name}" by ${artists} is on ${serviceName}. Convert tracks, albums, and artists between Spotify and Tidal instantly with Music Link Converter.`;
}

if (fromEntity && toEntity) {
  Astro.response.headers.set("Cache-Control", "max-age=10800");
  canonicalPath = `/convert?url=${encodeURIComponent(fromEntity.url)}`;
}
---

<Layout
  title={pageTitle}
  metaDescription={metaDescription}
  canonicalPath={canonicalPath}
  ogImageUrl={fromEntity?.images[0]?.url}
>
  <ContentContainer>
    <div class="header">
      <a href="/" title="Home" class="logo">
        <Logo width="48" height="48" />
      </a>
      <h1>{error ? "Error" : "Success!"}</h1>
      <p class="subtitle">
        {
          error ? (
            <>
              {error instanceof ValidationError
                ? "We couldn't process your link. Note that we only support Spotify and Tidal links, and that playlist links are not supported. Please check your link and try again."
                : "An error occurred while processing your request."}
            </>
          ) : fromEntity && toService ? (
            <>
              {toEntity ? (
                <>We found a match for </>
              ) : (
                <>Unfortunately, we couldn't find a match for </>
              )}
              <i>{fromEntity.name}</i>
              {fromEntity.type !== "artist" && (
                <>
                  {" "}
                  by{" "}
                  {fromEntity.artists.map((artist) => artist.name).join(", ")}
                </>
              )}{" "}
              on {toSentenceCase(toService)}.
            </>
          ) : null
        }
      </p>
    </div>

    <div class="conversion-content">
      {toEntity && <MusicCard entity={toEntity} service={toService!} />}

      {
        !fromEntity && fromUrl && (
          <p class="no-results">
            The {fromUrl.type} you specified wasn't found on{" "}
            {toSentenceCase(fromUrl.service)}.
          </p>
        )
      }

      {toEntity && <div class="arrow">↑</div>}

      {
        fromEntity && fromUrl && (
          <MusicCard entity={fromEntity} service={fromUrl.service} />
        )
      }

      {
        fromEntity && !toEntity && !error && (
          <p class="no-results">
            No match was found on{" "}
            {toService === "spotify" ? "Spotify" : "Tidal"}
          </p>
        )
      }

      <div class="back-link">
        <a href="/">← Convert another link</a>
      </div>
    </div>
  </ContentContainer>
</Layout>

<style>
  .header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .logo {
    display: block;
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
  }

  .subtitle {
    font-size: 1.125rem;
    margin: 0;
  }

  .back-link {
    margin-block: var(--space-lg);
    text-align: center;
  }

  .conversion-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .arrow {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2rem;
  }

  .no-results {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin: var(--space-xl) 0;
    padding: var(--space-lg);
    background: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: var(--radius-lg);
    max-width: 400px;
    text-align: center;
  }
</style>
