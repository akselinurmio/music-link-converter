---
export const prerender = true;

import AlbumIcon from "../assets/album.svg";
import ArrowRightIcon from "../assets/arrow-right.svg";
import Logo from "../assets/logo.svg";
import MusicIcon from "../assets/music.svg";
import SpotifyLogo from "../assets/spotify.svg";
import TidalLogo from "../assets/tidal.svg";
import UserIcon from "../assets/user.svg";
import ContentContainer from "../components/ContentContainer.astro";
import Footer from "../components/Footer.astro";
import UrlForm from "../components/UrlForm.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Convert Spotify links to Tidal"
  metaDescription="Convert any Spotify track, album, or artist URL to Tidal URL. Free and fast."
  canonicalPath="/spotify-to-tidal"
>
  <main class="fade-in">
    <ContentContainer>
      <div class="hero-content">
        <div class="hero-icon">
          <Logo width="64" height="64" />
        </div>

        <div class="platform-header">
          <div class="platform-icon spotify">
            <SpotifyLogo width="48" height="48" />
          </div>
          <div class="arrow">
            <ArrowRightIcon width="32" height="32" />
          </div>
          <div class="platform-icon tidal">
            <TidalLogo width="48" height="48" />
          </div>
        </div>

        <h1>Convert Spotify links to Tidal instantly</h1>

        <p class="hero-description">
          Transform Spotify tracks and artists into Tidal links instantly.
          Experience high-fidelity audio without missing your network's
          recommendations.
        </p>

        <div class="form-section">
          <UrlForm
            placeholder="Paste your Spotify link here..."
            buttonText="Convert to Tidal"
          />
        </div>

        <div class="examples">
          <h2>Supported Spotify Content</h2>
          <div class="content-types">
            <div class="content-type">
              <MusicIcon width="32" height="32" />
              <span>Tracks</span>
            </div>
            <div class="content-type">
              <AlbumIcon width="32" height="32" />
              <span>Albums</span>
            </div>
            <div class="content-type">
              <UserIcon width="32" height="32" />
              <span>Artists</span>
            </div>
          </div>
        </div>
      </div>
    </ContentContainer>
  </main>
  <Footer />
</Layout>

<style>
  .hero-content {
    text-align: center;
  }

  .hero-icon {
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
  }

  .platform-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .platform-icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
  }

  .platform-icon.spotify {
    background: #1ed760;
    color: white;
  }

  .platform-icon.tidal {
    background: #000000;
    color: white;
  }

  .hero-description {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto var(--space-2xl) auto;
    color: var(--text-secondary);
  }

  .benefits {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
    margin-bottom: var(--space-2xl);
  }

  .form-section {
    margin-bottom: var(--space-3xl);
  }

  .examples {
    text-align: center;
  }

  .examples h3 {
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
  }

  .content-types {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .content-type {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-secondary);
  }

  .content-type svg {
    color: var(--accent-primary);
  }

  .content-type span {
    font-weight: 500;
  }
</style>
