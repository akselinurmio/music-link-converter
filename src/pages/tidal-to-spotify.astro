---
export const prerender = true;

import AlbumIcon from "../assets/album.svg";
import ArrowRightIcon from "../assets/arrow-right.svg";
import Logo from "../assets/logo.svg";
import MusicIcon from "../assets/music.svg";
import SpotifyLogo from "../assets/spotify.svg";
import TidalLogo from "../assets/tidal.svg";
import UserIcon from "../assets/user.svg";
import ContentContainer from "../components/ContentContainer.astro";
import UrlForm from "../components/UrlForm.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Convert Tidal links to Spotify"
  metaDescription="Convert any Tidal track, album, or artist URL to Spotify URL. Free and fast."
  canonicalPath="/tidal-to-spotify"
>
  <ContentContainer>
    <div class="hero-content">
      <div class="hero-icon">
        <Logo width="64" height="64" />
      </div>

      <div class="platform-header">
        <div class="platform-icon tidal">
          <TidalLogo width="48" height="48" />
        </div>
        <div class="arrow">
          <ArrowRightIcon width="32" height="32" />
        </div>
        <div class="platform-icon spotify">
          <SpotifyLogo width="48" height="48" />
        </div>
      </div>

      <h1>Convert Tidal links to Spotify instantly</h1>

      <p class="hero-description">
        Have you got a friend who uses Tidal? Convert links to artists, tracks
        and albums from Tidal to Spotify seamlessly.
      </p>

      <div class="form-section">
        <UrlForm
          placeholder="Paste your Tidal link here..."
          buttonText="Convert to Spotify"
        />
      </div>

      <div class="content-types-section">
        <h2>Supported Tidal content</h2>
        <div class="content-types">
          <div class="content-type">
            <MusicIcon width="32" height="32" />
            <span>Tracks</span>
          </div>
          <div class="content-type">
            <AlbumIcon width="32" height="32" />
            <span>Albums</span>
          </div>
          <div class="content-type">
            <UserIcon width="32" height="32" />
            <span>Artists</span>
          </div>
        </div>
      </div>
    </div>
  </ContentContainer>
</Layout>

<style>
  .hero-content {
    text-align: center;
  }

  .hero-icon {
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
  }

  .platform-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .platform-icon {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
  }

  .platform-icon.tidal {
    background: #000000;
    color: white;
  }

  .platform-icon.spotify {
    background: #1ed760;
    color: white;
  }

  .hero-description {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto var(--space-2xl) auto;
    color: var(--text-secondary);
  }

  .form-section {
    margin-bottom: var(--space-2xl);
  }

  .content-types-section {
    text-align: center;
  }

  .content-types-section h2 {
    margin-bottom: var(--space-lg);
    color: var(--text-primary);
  }

  .content-types {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .content-type {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-secondary);
  }

  .content-type svg {
    color: var(--accent-primary);
  }

  .content-type span {
    font-weight: 500;
  }
</style>
