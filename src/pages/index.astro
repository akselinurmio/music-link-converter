---
export const prerender = true;

import Logo from "../assets/logo.svg";
import ContentContainer from "../components/ContentContainer.astro";
import UrlForm from "../components/UrlForm.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout canonicalPath="/">
  <ContentContainer>
    <div class="hero-content">
      <div class="hero-icon">
        <Logo width="64" height="64" />
      </div>

      <h1>Bridge the Gap Between Spotify and Tidal</h1>

      <p class="hero-description">
        Transform any track, album, or artist URL from one platform to another
        instantly. Free, fast, and open source.
      </p>
    </div>

    <div class="form-section">
      <UrlForm
        placeholder="Paste your Spotify or Tidal link here..."
        buttonText="Convert link"
      />
    </div>
  </ContentContainer>
</Layout>

<style>
  .hero-content {
    text-align: center;
  }

  .hero-icon {
    margin-bottom: var(--space-lg);
  }

  .hero-description {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto var(--space-2xl) auto;
    color: var(--text-secondary);
  }

  .form-section {
    margin-bottom: var(--space-xl);
  }
</style>
