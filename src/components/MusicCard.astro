---
import SpotifyLogo from "../assets/spotify.svg";
import TidalLogo from "../assets/tidal.svg";
import type { MusicEntity } from "../music-types";
import { formatArtistList, formatDuration } from "../utils/format";
import { getImageByWidth } from "../utils/images";

interface Props {
  entity: MusicEntity;
  service: "spotify" | "tidal";
}

const { entity, service } = Astro.props;

const minWidth = 140;
const { image1x, image2x } = getImageByWidth(entity.images, minWidth);

function formatReleaseDateTitle(releaseDate: string) {
  const match = releaseDate.match(/^\d{4}-\d{2}(-\d{2})/);

  if (!match) return null;

  if (match[1]) {
    return new Date(match[0]).toLocaleDateString("en", {
      dateStyle: "full",
      timeZone: "UTC",
    });
  }

  return new Date(match[0]).toLocaleDateString("en", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
}
---

<a
  href={entity.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={["card", service]}
>
  <div class="image-container">
    {
      image1x && (
        <img
          src={image1x.url}
          srcset={image2x && `${image1x.url}, ${image2x.url} 2x`}
          width={image1x.width}
          height={image1x.height}
          alt=""
          class="image"
        />
      )
    }
  </div>
  <div class="text-container">
    <h3 class="title">
      {entity.name}
    </h3>
    {entity.type === "song" && <p class="meta-text">{entity.album.name}</p>}
    {
      entity.type !== "artist" && (
        <p class="meta-text">{formatArtistList(entity.artists)}</p>
      )
    }
    {
      entity.type === "album" && (
        <time
          datetime={entity.releaseDate}
          class="meta-text"
          title={formatReleaseDateTitle(entity.releaseDate)}
        >
          {entity.releaseDate.substring(0, 4)}
        </time>
      )
    }
    <div class="tags">
      <div class="tag">
        {service === "spotify" ? "Spotify" : "Tidal"}
        {entity.type}
      </div>
      {
        entity.type === "song" && (
          <div class="tag">
            <time datetime={`PT${entity.durationSeconds}S`}>
              {formatDuration(entity.durationSeconds)}
            </time>
          </div>
        )
      }
    </div>
  </div>
  <div class="service-logo">
    {service === "spotify" ? <SpotifyLogo /> : <TidalLogo />}
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: 30% 1fr;
    gap: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background-color: var(--bg-primary);
    color: var(--text-primary);
    width: 100%;
    max-width: 500px;
    text-align: left;
    position: relative;
    transition:
      border-color var(--transition-normal),
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
    border: 1px solid var(--border-primary);
    text-decoration: none;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .card.spotify {
    border-color: rgb(30, 215, 96, 0.2);
  }
  .card.spotify:hover {
    border-color: rgb(30, 215, 96, 0.4);
  }

  .card.tidal {
    border-color: rgba(255, 255, 255, 0.2);
  }
  .card.tidal:hover {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .image {
    display: block;
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-sm);
  }

  .text-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .meta-text {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.9rem;
  }

  @media (hover: hover) {
    .meta-text[title] {
      text-decoration: underline dotted var(--text-muted);
    }
  }

  .tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: auto;
  }

  .tag {
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--border-primary);
  }

  .service-logo {
    position: absolute;
    bottom: var(--space-sm);
    right: var(--space-sm);
    color: var(--text-muted);
    opacity: 0.7;
    transition: opacity var(--transition-fast);
    width: 24px;
    height: 24px;
  }

  .service-logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  .card:hover .service-logo {
    opacity: 1;
  }

  .card.spotify .service-logo {
    color: #1ed760;
  }

  .card.tidal .service-logo {
    color: #ffffff;
  }
</style>
