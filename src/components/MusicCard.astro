---
import type { MusicEntity } from "../music-types";
import { getImageByWidth } from "../utils/images";
import SpotifyLogo from "../assets/spotify.svg";
import TidalLogo from "../assets/tidal.svg";

interface Props {
  entity: MusicEntity;
  service: "spotify" | "tidal";
}

const { entity, service } = Astro.props;

const minWidth = 230;
const { image1x, image2x } = getImageByWidth(entity.images, minWidth);
---

<a
  href={entity.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={["card", service]}
>
  <div class="image-container">
    {
      image1x && (
        <img
          src={image1x.url}
          srcset={image2x && `${image1x.url}, ${image2x.url} 2x`}
          width={image1x.width}
          height={image1x.height}
          alt=""
          class="image"
        />
      )
    }
  </div>
  <div class="text-container">
    <h3 class="title">
      {entity.name}
    </h3>
    {entity.type === "song" && <p class="meta-text">{entity.album.name}</p>}
    {
      entity.type !== "artist" && (
        <p class="meta-text">
          {entity.artists.map((artist) => artist.name).join(", ")}
        </p>
      )
    }
    {
      entity.type === "album" && (
        <time datetime={entity.releaseDate} class="meta-text">
          {entity.releaseDate.substring(0, 4)}
        </time>
      )
    }
    <div class="tags">
      {
        entity.type === "song" && (
          <div class="tag">
            <time datetime={`PT${entity.durationSeconds}S`}>
              {entity.durationFormatted}
            </time>
          </div>
        )
      }
      <div class="tag">{entity.type}</div>
    </div>
  </div>
  <div class="service-logo">
    {service === "spotify" ? <SpotifyLogo /> : <TidalLogo />}
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: 30% 1fr;
    gap: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background-color: var(--bg-card);
    color: var(--text-primary);
    width: 100%;
    max-width: 800px;
    text-align: left;
    position: relative;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
    border: 1px solid var(--border-primary);
    text-decoration: none;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .card.spotify {
    border-color: rgba(30, 215, 96, 0.2);
  }

  .card.tidal {
    border-color: var(--border-primary);
  }

  .image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .text-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .meta-text {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.9rem;
  }

  .tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: auto;
  }

  .tag {
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--border-primary);
  }

  .service-logo {
    position: absolute;
    bottom: var(--space-sm);
    right: var(--space-sm);
    color: var(--text-muted);
    opacity: 0.7;
    transition: opacity var(--transition-fast);
    width: 24px;
    height: 24px;
  }

  .service-logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  .card:hover .service-logo {
    opacity: 1;
  }

  .card.spotify .service-logo {
    color: #1db954;
  }

  .card.tidal .service-logo {
    color: var(--text-secondary);
  }
</style>
