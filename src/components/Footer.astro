---
import SpotifyLogo from "../assets/spotify.svg";
import TidalLogo from "../assets/tidal.svg";
---

<footer class="footer">
  <div class="platforms-section">
    <div class="platforms">
      <h2>Supported platforms</h2>
      <div class="platform-links">
        <a href="/spotify-to-tidal" class="platform">
          <div class="platform-icon spotify">
            <SpotifyLogo width="32" height="32" />
          </div>
          <span>Spotify to Tidal</span>
        </a>
        <a href="/tidal-to-spotify" class="platform">
          <div class="platform-icon tidal">
            <TidalLogo width="32" height="32" />
          </div>
          <span>Tidal to Spotify</span>
        </a>
      </div>
    </div>
    <div class="shortcuts">
      <h2>iOS Shortcuts</h2>
      <ul>
        <li>
          <a href="/shortcuts/Open Spotify link in Tidal.shortcut"
            >Open Spotify link in Tidal</a
          >
        </li>
      </ul>
      <ul>
        <li>
          <a href="/shortcuts/Open Tidal link in Spotify.shortcut"
            >Open Tidal link in Spotify</a
          >
        </li>
      </ul>
    </div>
  </div>
  <div class="footer-content">
    <div class="footer-section">
      <p class="disclaimer">
        This tool is not affiliated with Spotify or Tidal. All trademarks belong
        to their respective owners.
      </p>
    </div>
    <div class="footer-section">
      <p class="github-link">
        <a
          href="https://github.com/akselinurmio/music-link-converter"
          target="_blank"
          rel="noopener"
        >
          View on GitHub
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-primary);
    margin-top: auto;
    border-top: 1px solid var(--border-primary);
  }

  .platforms-section {
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--border-primary);
    display: flex;
    gap: var(--space-2xl);
    max-width: 800px;
    margin: 0 auto;
    padding-inline: var(--space-lg);
  }

  .platforms {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .platform-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .shortcuts {
    flex: 1;
    border-left: 1px solid var(--border-primary);
    padding-left: var(--space-2xl);
  }

  .shortcuts ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .shortcuts li {
    margin-bottom: var(--space-sm);
  }

  .shortcuts a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .shortcuts a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .platforms-section {
      flex-direction: column;
      gap: var(--space-xl);
      padding-inline: var(--space-md);
    }

    .platform-links {
      gap: var(--space-sm);
    }

    .shortcuts {
      border-left: none;
      border-top: 1px solid var(--border-primary);
      padding-left: 0;
      padding-top: var(--space-xl);
    }
  }

  .platform {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--transition-normal),
      border-color var(--transition-normal),
      background-color var(--transition-normal);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    border: 1px solid transparent;
  }

  .platform:hover {
    transform: translateY(-2px);
    border-color: var(--border-primary);
    background: var(--bg-primary);
  }

  .platform span {
    font-weight: 500;
    color: var(--text-secondary);
  }

  .platform-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
  }

  .platform-icon.spotify {
    background: #1ed760;
    color: white;
  }

  .platform-icon.tidal {
    background: #000000;
    color: white;
  }

  .footer-content {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
  }

  .footer-section {
    flex: 1;
  }

  .footer-section:first-child {
    flex: 2;
  }

  .disclaimer {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .github-link {
    text-align: right;
  }

  .github-link a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .github-link a:hover {
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
      gap: var(--space-md);
    }

    .github-link {
      text-align: center;
    }
  }
</style>
