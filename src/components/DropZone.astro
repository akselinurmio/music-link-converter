---
import DownloadIcon from "../assets/download.svg";
import { URL_INPUT_ID } from "../constants";
---

<div class="drop-zone" id="drop-zone" data-url-input-id={URL_INPUT_ID}>
  <div class="drop-zone-overlay" id="drop-overlay">
    <div class="drop-zone-content">
      <DownloadIcon class="drop-icon" width="48" height="48" />
      <p class="drop-text">Drop your music link here</p>
    </div>
  </div>
  <slot />
</div>

<script>
  const highlight = (dropOverlay: HTMLElement) => {
    dropOverlay.classList.add("active");
  };

  const unhighlight = (dropOverlay: HTMLElement) => {
    dropOverlay.classList.remove("active");
  };

  const extractUrlFromText = (text: string): string | null => {
    const urlMatch = text.match(/https?:\/\/[^\s]+/);
    return urlMatch ? urlMatch[0] : null;
  };

  const handleDrop = (e: DragEvent, urlInput: HTMLInputElement) => {
    e.preventDefault();
    e.stopPropagation();

    const dt = e.dataTransfer;
    if (!dt) return;

    const text = dt.getData("text/plain");
    if (text) {
      const url = extractUrlFromText(text);
      if (url) {
        urlInput.value = url;
        urlInput.focus();
      }
    }
  };

  const createDragEventListeners = (
    dropZone: HTMLElement,
    dropOverlay: HTMLElement,
    urlInput: HTMLInputElement
  ) => {
    for (const eventName of ["dragenter", "dragover"]) {
      dropZone.addEventListener(
        eventName,
        (e) => {
          e.preventDefault();
          e.stopPropagation();
          highlight(dropOverlay);
        },
        false
      );

      document.body.addEventListener(
        eventName,
        (e) => {
          e.preventDefault();
          e.stopPropagation();
        },
        false
      );
    }

    for (const eventName of ["dragleave", "drop"]) {
      dropZone.addEventListener(
        eventName,
        (e) => {
          e.preventDefault();
          e.stopPropagation();
          unhighlight(dropOverlay);
        },
        false
      );

      document.body.addEventListener(
        eventName,
        (e) => {
          e.preventDefault();
          e.stopPropagation();
        },
        false
      );
    }

    dropZone.addEventListener(
      "drop",
      (e) => handleDrop(e as DragEvent, urlInput),
      false
    );
  };

  const initializeDropZone = () => {
    const dropZone = document.getElementById("drop-zone");
    if (!dropZone) {
      throw new Error("Drop zone element not found");
    }

    const dropOverlay = document.getElementById("drop-overlay");
    if (!dropOverlay) {
      throw new Error("Drop overlay element not found");
    }

    const urlInputId = dropZone.dataset.urlInputId!;
    const urlInput = document.getElementById(urlInputId) as HTMLInputElement;

    if (!urlInput) {
      throw new Error(`URL input element with ID "${urlInputId}" not found`);
    }

    createDragEventListeners(dropZone, dropOverlay, urlInput);
  };

  try {
    initializeDropZone();
  } catch (error) {
    console.error("Failed to initialize drop zone:", error);
  }
</script>

<style>
  .drop-zone {
    position: relative;
    min-height: 100vh;
    width: 100%;
  }

  .drop-zone-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(99, 102, 241, 0.1);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-normal),
      visibility var(--transition-normal);
    border: 3px dashed var(--accent-primary);
  }

  .drop-zone-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .drop-zone-content {
    text-align: center;
    color: var(--text-primary);
  }

  .drop-icon {
    color: var(--accent-primary);
    margin-bottom: var(--space-md);
    animation: bounce 0.6s ease-in-out;
  }

  .drop-text {
    font-size: 1.25rem;
    font-weight: 500;
    margin: 0;
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }
</style>
